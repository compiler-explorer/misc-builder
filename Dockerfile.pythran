FROM ubuntu:22.04

RUN DEBIAN_FRONTEND=noninteractive apt-get --assume-yes update \
    && DEBIAN_FRONTEND=noninteractive apt-get --assume-yes \
    --no-install-recommends install \
        ca-certificates \
        curl \
        git \
        bc \
        make \
        xz-utils


RUN mkdir -p /root

# Miniforge defaults to the conda-forge channel; Miniconda's defaults channels
# require accepting Anaconda's Terms of Service, which breaks non-interactive builds.
RUN curl -L https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -o /root/miniforge.sh \
    && bash /root/miniforge.sh -b -u -p /root/miniforge3 \
    && rm -f /root/miniforge.sh

ENV PATH="/root/miniforge3/bin:${PATH}"

COPY pythran/ /root/
COPY common.sh /root/

WORKDIR /root
